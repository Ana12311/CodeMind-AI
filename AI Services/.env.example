# 复制为 .env 并填写真实值
APP_ENV=development
LOG_LEVEL=INFO

# LLM 提供方：mock | deepseek
LLM_PROVIDER=mock

# DeepSeek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# RAG
EMBEDDING_PROVIDER=bge-m3
# 本地开发用相对路径；Docker 内由 docker-compose 覆盖为 /models/bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# 仅 hashing 使用；bge-m3 维度由模型决定
EMBEDDING_DIM=256
# 通用向量库持久化路径，空=纯内存不持久化
VECTORSTORE_PATH=
RAG_DOCS_DIR=docs
RAG_TOP_K=3
RAG_MIN_SCORE=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# CODE_REVIEW 代码 RAG
CODE_REVIEW_DIR=
CODE_VECTORSTORE_PATH=
CODE_REVIEW_QUERY=分析代码中的安全问题、设计问题、性能问题

# 回调（Spring Boot）
CALLBACK_URL=
CALLBACK_TIMEOUT=10
CALLBACK_RETRIES=3
CALLBACK_RETRY_DELAY=1.0
