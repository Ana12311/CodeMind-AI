# =============================================================
# CodeMind-AI 全项目环境变量示例（占位符）
#
# 单一配置源，覆盖两个服务：
#   - "CodeMind AI Backend"   Java / Spring Boot
#   - "AI Services"           Python / FastAPI
#
# 使用方式：
#   1) 复制为 .env 或导出为系统环境变量，再填写真实值（勿提交真实值）
#   2) Java 侧：Spring Boot 通过 ${VAR} 占位符读取 OS 环境变量
#   3) Python 侧：pydantic-settings 读取 .env 文件与 OS 环境变量（环境变量优先）
#   4) Docker：在服务目录执行 `docker compose up`，先 `cp ../.env.example .env`
#
# 注意：本文件仅允许占位符，禁止填写真实密码 / 密钥。
# =============================================================

# ===================== MySQL（Java 侧） =====================
DB_HOST=
DB_PORT=3306
DB_NAME=codemind
DB_USERNAME=
DB_PASSWORD=

# ===================== Redis（Java 侧） =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# 开发环境 localhost 无密码可留空；生产环境必须设置
REDIS_PASSWORD=

# ===================== 服务地址 =====================
# Java 后端监听端口（Spring Boot 读取 SERVER_PORT，默认 8080）
SERVER_PORT=8080
# FastAPI 地址（Java 侧通过该地址提交 AI 任务）
AI_SERVICE_URL=http://localhost:8000

# ===================== 安全（Java 侧，必填） =====================
# JWT HS256 密钥，>=32 字节，禁止默认/示例值
JWT_SECRET=
# 内部服务 HMAC 签名密钥（Java <-> Python 鉴权）
INTERNAL_SECRET=

# ===================== 管理员初始化（Java 侧） =====================
# 首次启动且数据库无管理员时自动创建；密码至少 8 位，含字母和数字
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===================== AI 任务超时兜底（Java 侧） =====================
# PROCESSING 状态任务超过该时长仍未收到回调，自动置为失败（秒）
AI_TASK_REAPER_TIMEOUT_SECONDS=300
# 超时扫描执行间隔（毫秒）
AI_TASK_REAPER_INTERVAL_MS=60000

# ===================== LLM（Python 侧） =====================
# 提供方：mock（本地联调，不调真实模型）| deepseek
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Prompt 模板目录，空=使用 app/prompts
PROMPTS_DIR=

# ===================== RAG / 向量（Python 侧） =====================
# 向量库为进程内余弦相似度检索 + JSON 文件持久化（非外部向量数据库服务）
# 嵌入提供方：hashing（离线，默认）| bge-m3（语义，需先下载模型）
# 默认 hashing 零依赖直接可用；切换 bge-m3 需先执行：
#   huggingface-cli download BAAI/bge-m3 --local-dir "AI Services/models/bge-m3"
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# 仅 hashing 使用；bge-m3 维度由模型决定
EMBEDDING_DIM=256
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 通用向量库持久化路径，空=纯内存不持久化
VECTORSTORE_PATH=
# 代码审查向量库持久化路径，空=纯内存
CODE_VECTORSTORE_PATH=
# 启动时自动入库的文档目录，空=不入库
RAG_DOCS_DIR=docs
# 检索返回条数 / 最低相似度阈值
RAG_TOP_K=3
RAG_MIN_SCORE=0.5
# 代码审查入库目录（空=不启用）
CODE_REVIEW_DIR=
CODE_REVIEW_QUERY=分析代码中的安全问题、设计问题、性能问题
# 代码检索最低相似度阈值（跨语言通用查询 vs 代码，实测 0.3~0.45）
CODE_REVIEW_MIN_SCORE=0.3

# ===================== 回调（Python 侧） =====================
# 结果回调地址（Python 侧回调 Java）
CALLBACK_URL=http://localhost:8080/api/ai/task/callback
CALLBACK_TIMEOUT=10
CALLBACK_RETRIES=3
CALLBACK_RETRY_DELAY=1.0

# ===================== 应用（Python 侧） =====================
APP_ENV=development
LOG_LEVEL=INFO

# ===================== Docker 端口映射（可选） =====================
# 本机已跑原生 MySQL/Redis/App 时改成 3307/6378/8001/8081 等，避免端口冲突
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
APP_HOST_PORT=8080
AI_HOST_PORT=8000
# 前端 Nginx 容器对外端口（默认 80；端口被占用时改 3000 等）
FRONTEND_HOST_PORT=80
